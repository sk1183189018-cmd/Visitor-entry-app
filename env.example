============================================================

Building Visitor & Entry Management System

Environment Configuration Template

============================================================

IMPORTANT:

- Never put real production secrets in this file.

- Copy these variables into the appropriate environment secret

store or local .env file during development/deployment.

- This file contains names/examples only.

============================================================

------------------------------------------------------------

Application

------------------------------------------------------------

NODE_ENV=development

APP_NAME=Building-Entry-Management

APP_ENV=development

APP_URL=http://localhost:3000

API_URL=http://localhost:4000

VISITOR_WEB_URL=http://localhost:3000

ADMIN_WEB_URL=http://localhost:3001

RESIDENT_WEB_URL=http://localhost:3002

------------------------------------------------------------

Server

------------------------------------------------------------

API_HOST=0.0.0.0

API_PORT=4000

API_REQUEST_TIMEOUT_MS=30000

API_BODY_LIMIT=2mb

------------------------------------------------------------

Database

------------------------------------------------------------

DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

DATABASE_HOST=localhost

DATABASE_PORT=5432

DATABASE_NAME=building_entry

DATABASE_USER=DATABASE_USER

DATABASE_PASSWORD=DATABASE_PASSWORD

------------------------------------------------------------

Redis / Cache

------------------------------------------------------------

REDIS_URL=redis://localhost:6379

REDIS_HOST=localhost

REDIS_PORT=6379

REDIS_PASSWORD=

------------------------------------------------------------

Authentication

------------------------------------------------------------

AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME

AUTH_REFRESH_TOKEN_SECRET=CHANGE_ME

AUTH_ACCESS_TOKEN_EXPIRES_IN=15m

AUTH_REFRESH_TOKEN_EXPIRES_IN=30d

AUTH_ISSUER=building-entry-management

AUTH_AUDIENCE=building-entry-clients

------------------------------------------------------------

Password Security

------------------------------------------------------------

PASSWORD_HASH_ALGORITHM=argon2

PASSWORD_MIN_LENGTH=12

------------------------------------------------------------

OTP

------------------------------------------------------------

OTP_LENGTH=6

OTP_EXPIRES_IN_SECONDS=300

OTP_MAX_ATTEMPTS=5

OTP_RESEND_COOLDOWN_SECONDS=60

------------------------------------------------------------

CORS

------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

------------------------------------------------------------

File Storage

------------------------------------------------------------

STORAGE_DRIVER=local

STORAGE_LOCAL_PATH=./storage

MAX_UPLOAD_SIZE_MB=5

VISITOR_PHOTO_MAX_SIZE_MB=5

------------------------------------------------------------

Object Storage

------------------------------------------------------------

Required when production uses cloud/object storage.

OBJECT_STORAGE_PROVIDER=

OBJECT_STORAGE_BUCKET=

OBJECT_STORAGE_REGION=

OBJECT_STORAGE_ENDPOINT=

OBJECT_STORAGE_ACCESS_KEY=

OBJECT_STORAGE_SECRET_KEY=

------------------------------------------------------------

QR System

------------------------------------------------------------

QR_TOKEN_SECRET=CHANGE_ME

QR_DEFAULT_EXPIRY_MINUTES=30

QR_MAX_SCAN_ATTEMPTS=10

------------------------------------------------------------

Notifications

------------------------------------------------------------

NOTIFICATION_PUSH_ENABLED=true

NOTIFICATION_SMS_ENABLED=false

NOTIFICATION_EMAIL_ENABLED=false

NOTIFICATION_WHATSAPP_ENABLED=false

------------------------------------------------------------

Push Notifications

------------------------------------------------------------

PUSH_PROVIDER=

PUSH_PROJECT_ID=

PUSH_CLIENT_EMAIL=

PUSH_PRIVATE_KEY=

------------------------------------------------------------

SMS Provider

------------------------------------------------------------

SMS_PROVIDER=

SMS_API_URL=

SMS_API_KEY=

SMS_SENDER_ID=

------------------------------------------------------------

Email

------------------------------------------------------------

EMAIL_PROVIDER=

EMAIL_HOST=

EMAIL_PORT=

EMAIL_USERNAME=

EMAIL_PASSWORD=

EMAIL_FROM=

------------------------------------------------------------

WhatsApp Provider

------------------------------------------------------------

WHATSAPP_PROVIDER=

WHATSAPP_API_URL=

WHATSAPP_API_KEY=

WHATSAPP_PHONE_NUMBER_ID=

WHATSAPP_BUSINESS_ACCOUNT_ID=

------------------------------------------------------------

Background Worker

------------------------------------------------------------

WORKER_ENABLED=true

WORKER_CONCURRENCY=5

QUEUE_PREFIX=building-entry

------------------------------------------------------------

Excel Reporting

------------------------------------------------------------

EXCEL_REPORTS_ENABLED=true

EXCEL_REPORT_TIMEZONE=Asia/Kolkata

EXCEL_DAILY_REPORT_ENABLED=true

EXCEL_MONTHLY_REPORT_ENABLED=true

EXCEL_YEARLY_REPORT_ENABLED=true

EXCEL_MASTER_REPORT_ENABLED=true

REPORT_STORAGE_PATH=./storage/generated-reports

------------------------------------------------------------

Scheduled Jobs

------------------------------------------------------------

DAILY_REPORT_CRON=0 23 * * *

MONTHLY_REPORT_CRON=0 1 1 * *

YEARLY_REPORT_CRON=0 2 1 1 *

------------------------------------------------------------

Timezone

------------------------------------------------------------

APP_TIMEZONE=Asia/Kolkata

DATABASE_TIMEZONE=UTC

------------------------------------------------------------

Logging

------------------------------------------------------------

LOG_LEVEL=info

LOG_FORMAT=json

LOG_REQUESTS=true

LOG_SECURITY_EVENTS=true

------------------------------------------------------------

Audit Logging

------------------------------------------------------------

AUDIT_LOG_ENABLED=true

AUDIT_LOG_RETENTION_DAYS=365

------------------------------------------------------------

Rate Limiting

------------------------------------------------------------

RATE_LIMIT_ENABLED=true

RATE_LIMIT_WINDOW_SECONDS=60

RATE_LIMIT_MAX_REQUESTS=100

------------------------------------------------------------

Login Protection

------------------------------------------------------------

LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

------------------------------------------------------------

QR / Visitor Registration Protection

------------------------------------------------------------

VISITOR_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=60

VISITOR_REGISTRATION_RATE_LIMIT_MAX_REQUESTS=10

------------------------------------------------------------

Offline Synchronization

------------------------------------------------------------

OFFLINE_SYNC_ENABLED=true

SYNC_MAX_RETRY_ATTEMPTS=10

SYNC_RETRY_BASE_DELAY_MS=1000

------------------------------------------------------------

Realtime

------------------------------------------------------------

REALTIME_ENABLED=true

REALTIME_URL=http://localhost:4001

------------------------------------------------------------

WebSocket

------------------------------------------------------------

WEBSOCKET_PORT=4001

------------------------------------------------------------

Monitoring

------------------------------------------------------------

HEALTH_CHECK_ENABLED=true

METRICS_ENABLED=true

ERROR_TRACKING_ENABLED=false

ERROR_TRACKING_DSN=

------------------------------------------------------------

Security Headers

------------------------------------------------------------

SECURITY_HEADERS_ENABLED=true

HSTS_ENABLED=false

------------------------------------------------------------

Encryption

------------------------------------------------------------

Generate strong random values for production.

DATA_ENCRYPTION_KEY=CHANGE_ME

FILE_ENCRYPTION_KEY=CHANGE_ME

------------------------------------------------------------

Backup

------------------------------------------------------------

BACKUP_ENABLED=false

BACKUP_STORAGE_PROVIDER=

BACKUP_RETENTION_DAYS=30

------------------------------------------------------------

Development

------------------------------------------------------------

DEBUG=false

DEV_SEED_DATABASE=false

DEV_ALLOW_TEST_OTP=false

------------------------------------------------------------

Testing

------------------------------------------------------------

TEST_DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/building_entry_test

TEST_REDIS_URL=redis://localhost:6379/1

------------------------------------------------------------

Production Safety

------------------------------------------------------------

These should be enforced by deployment configuration.

ALLOW_PRODUCTION_DEBUG=false

ALLOW_INSECURE_HTTP=false

ALLOW_TEST_OTP_IN_PRODUCTION=false
